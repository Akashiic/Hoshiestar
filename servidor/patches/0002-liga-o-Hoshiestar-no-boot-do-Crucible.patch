From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Akashic <hoshiestar@localhost>
Date: Sun, 22 Nov 2026 10:34:18 +0000
Subject: [PATCH 2/7] liga o Hoshiestar no boot do Crucible

CrucibleCoremodHook le o hoshiestar.yml e registra o transformador antes dos
transformadores do Crucible e de qualquer coremod/Mixin; CrucibleModContainer
registra o comando hoshie e loga o resumo dos recursos depois do Done.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ELhLZzamveLVoauHRY3hDN

diff --git a/src/main/java/io/github/crucible/CrucibleModContainer.java b/src/main/java/io/github/crucible/CrucibleModContainer.java
index b9b19c0c..e7a4d50c 100644
--- a/src/main/java/io/github/crucible/CrucibleModContainer.java
+++ b/src/main/java/io/github/crucible/CrucibleModContainer.java
@@ -87,10 +87,18 @@ public class CrucibleModContainer extends DummyModContainer implements Plugin {
     @Subscribe
     public void serverStarting(FMLServerStartingEvent evt) {
         evt.registerServerCommand("crucible", new CrucibleCommand(evt.getServer()));
+        hoshiestar.Servidor.iniciando(evt); // Hoshiestar - comando "hoshie"
         CrucibleAPI.registerModPlugin(this);
         metrics = new Metrics(this, 6555);
     }
 
+    // Hoshiestar start - resumo dos recursos logo depois do "Done"
+    @Subscribe
+    public void serverStarted(FMLServerStartedEvent evt) {
+        hoshiestar.Servidor.pronto();
+    }
+    // Hoshiestar end
+
     @Override
     public List<String> getOwnedPackages() {
         return ImmutableList.of(
diff --git a/src/main/java/io/github/crucible/bootstrap/CrucibleCoremodHook.java b/src/main/java/io/github/crucible/bootstrap/CrucibleCoremodHook.java
index 45758da1..a3d67f63 100644
--- a/src/main/java/io/github/crucible/bootstrap/CrucibleCoremodHook.java
+++ b/src/main/java/io/github/crucible/bootstrap/CrucibleCoremodHook.java
@@ -15,7 +15,21 @@ public class CrucibleCoremodHook {
         } catch (ClassNotFoundException e) {
             throw new RuntimeException(e);
         }
-        
+
+        // Hoshiestar start - le o hoshiestar.yml e registra o transformador das correcoes embutidas
+        // ANTES dos transformadores do Crucible e de qualquer coremod/Mixin de mod. Por reflexao e
+        // pelo LaunchClassLoader: esta classe e do class loader da aplicacao, e o Hoshiestar tem de
+        // morar no mesmo class loader dos mods.
+        try {
+            Class.forName("hoshiestar.Inicio", true, classLoader)
+                    .getMethod("coremod", LaunchClassLoader.class)
+                    .invoke(null, classLoader);
+        } catch (Throwable t) {
+            System.err.println("[Hoshiestar] falha ao iniciar; o servidor segue como Crucible puro: " + t);
+            t.printStackTrace();
+        }
+        // Hoshiestar end
+
         classLoader.registerTransformer("io.github.crucible.patches.StreamsTransformer");
         classLoader.registerTransformer("thermos.ThermosClassTransformer");
     }
