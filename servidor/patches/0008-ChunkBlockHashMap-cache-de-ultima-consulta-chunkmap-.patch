diff --git a/src/main/java/thermos/wrapper/ChunkBlockHashMap.java b/src/main/java/thermos/wrapper/ChunkBlockHashMap.java
index 9fa8c4c2..ac48f32d 100644
--- a/src/main/java/thermos/wrapper/ChunkBlockHashMap.java
