 +                    if (hoshiestar.observador.Observador.ATIVO) hoshiestar.observador.GanchosObservador.tile(this, tileentity); // Hoshiestar - observador: contexto "tile da vez" (mesmo lugar do medidor: antes do update, sem try/catch, fora da linha da chamada)
