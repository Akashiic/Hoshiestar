 +        if (hoshiestar.orcamento.Orcamento.LIGADO) hoshiestar.orcamento.GanchosOrcamento.fimTick(); // Hoshiestar - orcamento: tempo do tick, custo por regiao, avaliacao e alertas (nunca lanca)
      }
  
++    // Hoshiestar start - paralelo (teste, so com -Dhoshiestar.paralelo.teste=true): salvamento unico no tick em que os mundos congelam
++    private void hoshieSalvarCongelado()
++    {
++        try
++        {
++            this.serverConfigManager.saveAllPlayerData();
++            this.saveAllWorlds(false);
++            hoshiestar.api.Log.info("paralelo (teste): mundos congelados no tick " + hoshiestar.paralelo.Congelar.congeladoEm() + " do mundo 0 (pedido " + hoshiestar.paralelo.Congelar.alvo() + "); salvamento pedido. Pare com 'stop'.");
++        }
++        catch (Throwable hoshieErro)
++        {
++            hoshiestar.api.Log.erro("paralelo (teste): salvamento do congelar falhou (os mundos seguem congelados; o 'stop' salva de novo)", hoshieErro);
++        }
++    }
++    // Hoshiestar end
++
